{
  "_metadata": {
    "config_type": "provider_config",
    "created_date": "2025-07-23T08:15:00.000000Z",
    "last_updated": "2025-07-23T08:15:00.000000Z",
    "version": "1.0.0"
  },
  "api_base": "default_api_base",
  "api_type": "openai",
  "auth_header": "authorization",
  "base_url": "https://router.requesty.ai/v1",
  "cost_optimization": "Routes to cheapest available model for task",
  "default": false,
  "description": "Multi-model router supporting Anthropic, OpenAI, and Google models",
  "display_name": "Requesty Router",
  "enabled": true,
  "env_var": "REQUESTY_API_KEY",
  "name": "requesty",
  "rate_limits": {
    "requests_per_minute": 500,
    "tokens_per_minute": 100000
  },
  "secure": true,
  "supported_model_families": [
    "anthropic",
    "openai",
    "google"
  ],
  "supports_streaming": true,
  "timeout": 30,
  "type": "default_type"
}