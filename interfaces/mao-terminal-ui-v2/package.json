{
	"name": "mao-terminal-ui",
	"version": "4.0.0",
	"description": "Mao Terminal Interface - Modern AI chat experience with emotional intelligence",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "prettier --check . && xo && ava",
		"start": "node dist/cli.js",
		"mao": "node dist/cli.js"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"ink": "^4.4.1",
		"meow": "^13.2.0",
		"react": "^18.3.1",
		"chalk": "^5.3.0",
		"gradient-string": "^2.0.2",
		"figlet": "^1.7.0",
		"ora": "^8.0.1",
		"ink-spinner": "^5.0.0",
		"ink-text-input": "^5.0.1",
		"ink-select-input": "^6.0.0",
		"ink-box": "^3.0.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/react": "^18.3.12",
		"@types/figlet": "^1.5.8",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^6.1.3",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.0.0",
		"ink-testing-library": "^4.0.0",
		"prettier": "^3.3.3",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.2",
		"xo": "^0.59.3"
	},
	"ava": {
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--loader=ts-node/esm"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config"
}
