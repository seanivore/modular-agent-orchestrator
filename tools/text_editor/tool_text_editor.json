{
  "name": "text_editor",
  "display_name": "Text Editor",
  "version": "4.0.0",
  "description": "Advanced text editing with AI assistance and seamless autosave functionality",
  "capabilities": [
    "document_creation",
    "content_editing", 
    "content_appending",
    "document_formatting",
    "content_analysis",
    "path_validation",
    "template_support",
    "seamless_autosave",
    "backup_creation"
  ],
  "cost_estimate": 0.002,
  "models_supported": [
    "claude-sonnet-4",
    "claude-haiku-4",
    "gpt-4", 
    "gpt-4-turbo",
    "gemini-pro"
  ],
  "tags": [
    "text",
    "editor", 
    "document",
    "content",
    "writing",
    "formatting",
    "autosave",
    "backup",
    "template",
    "analysis"
  ],
  "file_path": "tools/text_editor/text_editor.py",
  "button_path": "tools/text_editor/button_text_editor.py",
  "ui_path": "tools/text_editor/ui_text_editor.py",
  "operations": {
    "create_document": {
      "description": "Create a new document with optional initial content",
      "required_params": ["file_path"],
      "optional_params": ["content", "document_type"]
    },
    "edit_content": {
      "description": "Edit specific content in a document with automatic backup",
      "required_params": ["file_path", "old_text", "new_text"],
      "optional_params": ["create_backup"]
    },
    "append_content": {
      "description": "Append content to an existing document",
      "required_params": ["file_path", "content"],
      "optional_params": ["separator"]
    },
    "format_document": {
      "description": "Prepare document for AI-powered formatting",
      "required_params": ["file_path"],
      "optional_params": ["format_type", "preserve_backup"]
    },
    "get_document_info": {
      "description": "Get comprehensive information about a document",
      "required_params": ["file_path"],
      "optional_params": []
    },
    "validate_document_path": {
      "description": "Validate a document path for editing operations",
      "required_params": ["file_path"],
      "optional_params": []
    },
    "create_document_from_template": {
      "description": "Create a document from a predefined template",
      "required_params": ["file_path", "template_type"],
      "optional_params": ["title", "author"]
    }
  },
  "integration": {
    "memory_mcp": true,
    "cache_system": true,
    "error_handling": true
  }
}