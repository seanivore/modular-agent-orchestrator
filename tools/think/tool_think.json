{
  "name": "think",
  "display_name": "Sequential Thinking",
  "version": "4.0.0",
  "description": "Simple structured thinking and reasoning capabilities for AI agents",
  "capabilities": [
    "reasoning",
    "analysis", 
    "structured_thinking",
    "prompt_enhancement"
  ],
  "cost_estimate": 0.01,
  "models_supported": [
    "claude-3-5-sonnet",
    "claude-sonnet-4",
    "gpt-4",
    "gpt-4-turbo", 
    "gemini-pro"
  ],
  "tags": [
    "core",
    "reasoning",
    "analysis",
    "thinking",
    "flexible"
  ],
  "file_path": "tools/think/think.py",
  "button_path": "tools/think/button_think.py",
  "ui_path": "tools/think/ui_think.py",
  "operations": {
    "perform_thinking": {
      "description": "Perform structured AI thinking about a topic",
      "required_params": ["topic"],
      "optional_params": ["thinking_approach", "thinking_focus", "context", "save_results"]
    },
    "enhance_thinking_prompt": {
      "description": "Enhance a thinking prompt for better results",
      "required_params": ["base_topic"],
      "optional_params": ["enhancement_approach", "enhancement_focus"]
    },
    "validate_thinking_setup": {
      "description": "Validate that thinking operations can be performed",
      "required_params": [],
      "optional_params": []
    },
    "get_thinking_capabilities": {
      "description": "Get information about thinking tool capabilities",
      "required_params": [],
      "optional_params": []
    }
  },
  "integration": {
    "memory_mcp": true,
    "cache_system": true,
    "error_handling": true
  }
}