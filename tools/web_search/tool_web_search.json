{
  "name": "web_search",
  "display_name": "Native Web Search",
  "version": "4.0.0",
  "description": "Real-time web search using Anthropic's native capabilities",
  "capabilities": [
    "web_search",
    "filtered_search",
    "content_search",
    "query_validation",
    "search_suggestions",
    "real_time_results",
    "source_verification"
  ],
  "cost_estimate": 0.01,
  "models_supported": [
    "claude-sonnet-4",
    "claude-3-5-sonnet",
    "claude-3-7-sonnet"
  ],
  "tags": [
    "search",
    "web",
    "research",
    "realtime",
    "native",
    "anthropic",
    "information",
    "sources",
    "validation",
    "suggestions"
  ],
  "file_path": "tools/web_search/web_search.py",
  "button_path": "tools/web_search/button_web_search.py",
  "ui_path": "tools/web_search/ui_web_search.py",
  "operations": {
    "perform_web_search": {
      "description": "Perform basic web search with query and result limit",
      "required_params": ["query"],
      "optional_params": ["max_results", "search_context"]
    },
    "perform_filtered_search": {
      "description": "Perform web search with domain and date constraints",
      "required_params": ["query"],
      "optional_params": ["domain", "date_range", "max_results"]
    },
    "perform_content_search": {
      "description": "Perform content-specific web search",
      "required_params": ["query"],
      "optional_params": ["content_type", "max_results"]
    },
    "validate_search_query": {
      "description": "Validate a search query for potential issues",
      "required_params": ["query"],
      "optional_params": []
    },
    "get_search_suggestions": {
      "description": "Generate search query suggestions and improvements",
      "required_params": ["query"],
      "optional_params": ["suggestion_type"]
    }
  },
  "integration": {
    "memory_mcp": true,
    "cache_system": true,
    "error_handling": true
  }
}