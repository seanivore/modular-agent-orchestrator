{
  "command": "update",
  "type": "needs_file_or_directory",
  "terminal_flag": "--update",
  "app_command": "/update",
  "interface_method": "update_workflow",
  "help": "Update workflow with multi-path support and secondary flags",
  "cost_estimate": 0.005,
  "logic_file": "configs/cli/update/update.py",
  "ui_file": "configs/cli/update/ui_update.py",
  "operations": {
    "execute": {
      "description": "Execute workflow update with JSON file",
      "required_params": ["json_file"],
      "optional_params": ["target_directory", "add", "remove", "replace", "rename", "chat"]
    }
  },
  "secondary_flags": {
    "add": {
      "description": "Add new phases or agents to workflow",
      "format": "type:name",
      "examples": ["phase:testing", "agent:validator"]
    },
    "remove": {
      "description": "Remove existing phases or agents",
      "format": "type:name", 
      "examples": ["phase:outdated", "agent:deprecated"]
    },
    "replace": {
      "description": "Replace existing workflow elements",
      "format": "type:old:new",
      "examples": ["phase:dev:development", "agent:old:new"]
    },
    "rename": {
      "description": "Rename workflow elements",
      "format": "old:new",
      "examples": ["old_name:new_name", "test:testing"]
    },
    "chat": {
      "description": "Natural language workflow updates",
      "format": "message",
      "examples": ["add phase called validation", "update goal to include testing"]
    }
  },
  "integration": {
    "memory_mcp": true,
    "cache_system": true,
    "error_handling": true,
    "manager_touchpoints": ["workflow_manager", "workflow_state", "memory_mcp"]
  },
  "cache_settings": {
    "enabled": true,
    "duration_seconds": 300,
    "cache_key_includes": ["file_modification_time", "directory_state", "json_content"]
  },
  "multi_path_support": {
    "enabled": true,
    "auto_detect_workflow_directory": true,
    "auto_copy_json": true,
    "supported_paths": ["relative", "absolute", "workflow_directory", "regular_directory"]
  }
}