{
  "command": "continue",
  "type": "standalone",
  "terminal_flag": "--continue",
  "app_command": "/continue",
  "interface_method": "continue_workflow",
  "help": "Resume interrupted workflow sessions",
  "cost_estimate": 0.007,
  "logic_file": "configs/cli/continue/continue.py",
  "ui_file": "configs/cli/continue/ui_continue.py",
  "operations": {
    "continue_recent": {
      "description": "Resume most recent interrupted workflow",
      "required_params": [],
      "optional_params": ["strategy"]
    },
    "continue_specific": {
      "description": "Resume specific workflow by ID or command",
      "required_params": ["workflow_id"],
      "optional_params": ["force_resume"]
    },
    "list_continuable": {
      "description": "List all workflows available for continuation",
      "required_params": [],
      "optional_params": ["user_filter"]
    }
  },
  "integration": {
    "workflow_manager": true,
    "workflow_state": true,
    "memory_mcp": true,
    "username_manager": true,
    "cache_system": true,
    "error_handling": true
  },
  "cache_settings": {
    "enabled": true,
    "duration_seconds": 120,
    "cache_key_includes": ["user_context", "workflow_state", "directory_mtime"]
  },
  "final_implementation_details": {
    "task_5_phase_2_compliance": true,
    "workflow_state_management": "full_implementation",
    "continue_review_integration": true,
    "user_workflow_id_support": true,
    "interruption_recovery": "all_phases",
    "memory_mcp_persistence": true
  }
}