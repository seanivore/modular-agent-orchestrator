{
  "app_command": "/models",
  "cache_settings": {
    "cache_key_includes": [
      "models_directory_state",
      "model_files_modification_times"
    ],
    "duration_seconds": 600,
    "enabled": true
  },
  "command": "models",
  "cost_estimate": 0.002,
  "help": "List all available models with display names and metadata",
  "integration": {
    "cache_system": true,
    "error_handling": true,
    "memory_mcp": false,
    "specific_touchpoints": [
      "manager_models"
    ],
    "universal_touchpoints": [
      "cli_manager",
      "ui_terminal"
    ]
  },
  "interface_method": "models",
  "logic_file": "configs/cli/models/models.py",
  "max_tokens": 0,
  "name": "default_name",
  "operations": {
    "execute": {
      "description": "Display list of all available models with provider and capability information",
      "optional_params": [],
      "required_params": []
    }
  },
  "provider": "default_provider",
  "terminal_flag": "--models",
  "type": "standalone",
  "ui_file": "configs/cli/models/ui_models.py"
}