{
  "name": "double_texting_app_settings",
  "description": "Configure conversation interruption preferences",
  "version": "1.0",
  "double_texting": {
    "default": "always",
    "description": "Interrupt Mao like any messenger experience",
    "type": "select",
    "options": [
