#!/usr/bin/env python3
"""
MAO Import Audit Script
Finds all import inconsistencies, sys.path.append mismatches, and suggests fixes

This script analyzes the entire codebase to find:
1. sys.path.append statements that should be clean dotted imports
2. Inconsistent import patterns for the same modules
3. Missing or incorrect imports
4. Unused imports after fixes
"""

import os
import re
import sys
import json
from pathlib import Path
from typing import Dict, List, Tuple, Set, Any
from collections import defaultdict, Counter

class ImportAuditor:
    def __init__(self, project_root: str = "."):
        self.project_root = Path(project_root)
        self.issues = []
        self.import_patterns = defaultdict(list)
        self.sys_path_issues = []
        self.inconsistent_imports = defaultdict(list)
        
        # Known module mappings for clean imports
        self.clean_import_patterns = {
            "user_id_generator": "scripts.user_id_generator.user_id_generator",
            "unique_id_generator": "scripts.unique_id_generator.unique_id_generator",
            "cache_system": "orchestrator.cache.cache_system",
            "error_handling": "orchestrator.error_handling",
            "username_manager": "orchestrator.username_manager",
            "workflow_manager": "orchestrator.workflow_manager",
            "settings_manager": "orchestrator.settings_manager"
        }
        
        # Files to exclude from audit
        self.exclude_patterns = [
            "*.pyc", "__pycache__", ".git", "node_modules", 
            "*.backup", "*.orig", ".DS_Store",
            "versioning/v*/", "tests/typescript-*"
        ]

    def should_exclude_file(self, file_path: Path) -> bool:
        """Check if file should be excluded from audit"""
        file_str = str(file_path)
        for pattern in self.exclude_patterns:
            if pattern.replace("*", "") in file_str:
                return True
        return False

    def find_all_python_files(self) -> List[Path]:
        """Find all Python files in the project"""
        python_files = []
        for py_file in self.project_root.rglob("*.py"):
            if not self.should_exclude_file(py_file):
                python_files.append(py_file)
        return python_files

    def analyze_sys_path_append(self, file_path: Path, content: str) -> List[Dict]:
        """Find all sys.path.append statements and analyze them"""
        issues = []
        lines = content.split('\n')
        
        for i, line in enumerate(lines, 1):
            if 'sys.path.append' in line:
                # Extract the path being added
                match = re.search(r'sys\.path\.append\((.*?)\)', line)
                if match:
                    path_expr = match.group(1)
                    
                    # Look for the import that follows
                    following_import = None
                    for j in range(i, min(i + 5, len(lines))):
                        if j < len(lines) and lines[j].strip().startswith('from '):
                            following_import = lines[j].strip()
                            break
                    
                    issues.append({
                        'file': str(file_path),
                        'line': i,
                        'sys_path_line': line.strip(),
                        'following_import': following_import,
                        'suggested_fix': self.suggest_clean_import(following_import)
                    })
        
        return issues

    def suggest_clean_import(self, import_line: str) -> str:
        """Suggest a clean dotted import for a given import line"""
        if not import_line:
            return "Unable to determine - check manually"
        
        # Parse the import
        if 'from ' in import_line and ' import ' in import_line:
            parts = import_line.replace('from ', '').split(' import ')
            module = parts[0].strip()
            imports = parts[1].strip()
            
            # Check if we have a known clean pattern
            for old_pattern, new_pattern in self.clean_import_patterns.items():
                if old_pattern in module:
                    return f"from {new_pattern} import {imports}"
        
        return f"Review manually: {import_line}"

    def analyze_import_patterns(self, file_path: Path, content: str) -> None:
        """Analyze import patterns to find inconsistencies"""
        lines = content.split('\n')
        
        for i, line in enumerate(lines, 1):
            line = line.strip()
            if line.startswith('from ') and ' import ' in line:
                # Extract module and what's being imported
                parts = line.replace('from ', '').split(' import ')
                if len(parts) == 2:
                    module = parts[0].strip()
                    imports = parts[1].strip()
                    
                    # Track this pattern
                    self.import_patterns[module].append({
                        'file': str(file_path),
                        'line': i,
                        'full_import': line,
                        'imports': imports
                    })

    def find_inconsistent_imports(self) -> Dict[str, List]:
        """Find modules that are imported in different ways"""
        inconsistencies = {}
        
        for module, usages in self.import_patterns.items():
            if len(usages) > 1:
                # Group by the actual import pattern
                patterns = defaultdict(list)
                for usage in usages:
                    pattern_key = f"{module} -> {usage['imports']}"
                    patterns[pattern_key].append(usage)
                
                # If there are multiple patterns for the same module, it might be inconsistent
                if len(patterns) > 1 or any('user_id_generator' in module or 'unique_id_generator' in module for usage in usages):
                    inconsistencies[module] = {
                        'patterns': dict(patterns),
                        'total_usages': len(usages)
                    }
        
        return inconsistencies

    def check_unused_imports(self, file_path: Path, content: str) -> List[Dict]:
        """Check for potentially unused imports after sys.path.append removal"""
        lines = content.split('\n')
        imports = []
        usage_checks = []
        
        for i, line in enumerate(lines, 1):
            line_stripped = line.strip()
            if line_stripped.startswith('import ') and not line_stripped.startswith('import sys') and not line_stripped.startswith('import os'):
                continue
            elif line_stripped in ['import sys', 'import os']:
                # Check if sys or os is used elsewhere
                import_name = line_stripped.split()[1]
                used_elsewhere = any(f'{import_name}.' in other_line for j, other_line in enumerate(lines) if j != i)
                
                if not used_elsewhere:
                    usage_checks.append({
                        'file': str(file_path),
                        'line': i,
                        'import': line_stripped,
                        'potentially_unused': True
                    })
        
        return usage_checks

    def audit_file(self, file_path: Path) -> None:
        """Perform complete audit on a single file"""
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                content = f.read()
            
            # Check for sys.path.append issues
            sys_path_issues = self.analyze_sys_path_append(file_path, content)
            self.sys_path_issues.extend(sys_path_issues)
            
            # Analyze import patterns
            self.analyze_import_patterns(file_path, content)
            
            # Check for unused imports
            unused_imports = self.check_unused_imports(file_path, content)
            if unused_imports:
                self.issues.extend(unused_imports)
        
        except Exception as e:
            self.issues.append({
                'file': str(file_path),
                'error': f"Failed to analyze: {str(e)}"
            })

    def run_audit(self) -> Dict[str, Any]:
        """Run complete import audit"""
        print("🔍 Starting MAO Import Audit...")
        
        python_files = self.find_all_python_files()
        print(f"📁 Found {len(python_files)} Python files to analyze")
        
        # Analyze each file
        for file_path in python_files:
            self.audit_file(file_path)
        
        # Find inconsistent import patterns
        inconsistent_imports = self.find_inconsistent_imports()
        
        # Compile results
        results = {
            'summary': {
                'total_files_analyzed': len(python_files),
                'sys_path_issues_found': len(self.sys_path_issues),
                'inconsistent_import_modules': len(inconsistent_imports),
                'other_issues': len(self.issues)
            },
            'sys_path_issues': self.sys_path_issues,
            'inconsistent_imports': inconsistent_imports,
            'other_issues': self.issues,
            'recommendations': self.generate_recommendations()
        }
        
        return results

    def generate_recommendations(self) -> List[str]:
        """Generate actionable recommendations"""
        recommendations = []
        
        if self.sys_path_issues:
            recommendations.append("🔧 Replace all sys.path.append statements with clean dotted imports")
            recommendations.append("🧹 Remove unused 'import sys' and 'import os' statements after fixing sys.path.append")
        
        if any('user_id_generator' in module for module in self.import_patterns.keys()):
            recommendations.append("📦 Standardize user_id_generator imports to use: from scripts.user_id_generator.user_id_generator import ...")
        
        if any('unique_id_generator' in module for module in self.import_patterns.keys()):
            recommendations.append("📦 Standardize unique_id_generator imports to use: from scripts.unique_id_generator.unique_id_generator import ...")
        
        recommendations.append("✅ Run tests after each fix to ensure functionality")
        recommendations.append("🔄 Re-run this audit script after fixes to verify all issues resolved")
        
        return recommendations

    def generate_report(self, output_file: str = "import_audit_report.json") -> None:
        """Generate detailed audit report"""
        results = self.run_audit()
        
        # Save JSON report
        with open(output_file, 'w') as f:
            json.dump(results, f, indent=2)
        
        # Print summary
        print("\n" + "="*60)
        print("📊 MAO IMPORT AUDIT RESULTS")
        print("="*60)
        
        summary = results['summary']
        print(f"📁 Total files analyzed: {summary['total_files_analyzed']}")
        print(f"🚨 sys.path.append issues: {summary['sys_path_issues_found']}")
        print(f"⚠️  Inconsistent imports: {summary['inconsistent_import_modules']}")
        print(f"🔍 Other issues: {summary['other_issues']}")
        
        if results['sys_path_issues']:
            print(f"\n🔧 SYS.PATH.APPEND ISSUES ({len(results['sys_path_issues'])}):")
            for issue in results['sys_path_issues'][:10]:  # Show first 10
                rel_path = str(Path(issue['file']).relative_to(self.project_root))
                print(f"  📄 {rel_path}:{issue['line']}")
                print(f"     Current: {issue['sys_path_line']}")
                if issue['following_import']:
                    print(f"     Import: {issue['following_import']}")
                print(f"     Fix: {issue['suggested_fix']}")
                print()
        
        if results['inconsistent_imports']:
            print(f"\n⚠️  INCONSISTENT IMPORTS:")
            for module, data in list(results['inconsistent_imports'].items())[:5]:
                print(f"  📦 {module} ({data['total_usages']} usages)")
                for pattern, usages in data['patterns'].items():
                    print(f"     {pattern} - {len(usages)} files")
        
        print(f"\n💡 RECOMMENDATIONS:")
        for rec in results['recommendations']:
            print(f"  {rec}")
        
        print(f"\n📄 Full report saved to: {output_file}")
        print("="*60)

def main():
    """Run the import audit"""
    auditor = ImportAuditor()
    auditor.generate_report()

if __name__ == "__main__":
    main() 