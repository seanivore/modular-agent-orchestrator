{
  "description": "MCP Server Configurations for external tool integration",
  "global_settings": {
    "auto_start": false,
    "log_level": "INFO",
    "retry_attempts": 3,
    "timeout_seconds": 30
  },
  "servers": {
    "aider": {
      "command": [
        "python",
        "-m",
        "aider.mcp"
      ],
      "description": "Aider code editing MCP server",
      "enabled": false,
      "name": "aider",
      "requirements": [
        "aider-chat"
      ],
      "tools": [
        "edit_file",
        "create_file",
        "read_file"
      ]
    },
    "brave_search": {
      "command": [
        "npx",
        "@modelcontextprotocol/server-brave-search"
      ],
      "description": "Brave search MCP server",
      "enabled": false,
      "env_vars": [
        "BRAVE_API_KEY"
      ],
      "name": "brave_search",
      "requirements": [
        "@modelcontextprotocol/server-brave-search"
      ],
      "tools": [
        "brave_web_search"
      ]
    },
    "filesystem": {
      "command": [
        "npx",
        "@modelcontextprotocol/server-filesystem"
      ],
      "description": "File system operations MCP server",
      "enabled": false,
      "name": "filesystem",
      "requirements": [
        "@modelcontextprotocol/server-filesystem"
      ],
      "tools": [
        "read_file",
        "write_file",
        "list_directory"
      ]
    },
    "github": {
      "command": [
        "npx",
        "@modelcontextprotocol/server-github"
      ],
      "description": "GitHub repository operations MCP server",
      "enabled": false,
      "env_vars": [
        "GITHUB_TOKEN"
      ],
      "name": "github",
      "requirements": [
        "@modelcontextprotocol/server-github"
      ],
      "tools": [
        "create_repository",
        "search_repositories",
        "get_file_contents"
      ]
    }
  }
}