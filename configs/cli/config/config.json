{
  "name": "config",
  "command": "config",
  "type": "manager_integration",
  "complexity": "medium",
  "terminal_flag": "--config",
  "app_command": "/config",
  "interface_method": "open_config_management",
  "help": "Application settings management with user configuration persistence",
  "file_path": "configs/cli/config/config.py",
  "ui_path": "configs/cli/config/ui_config.py",
  "description": "Manage application settings, discover available configurations, and update user preferences with automatic JSON file management via User ID/Username",
  "integration_requirements": {
    "primary_manager": "settings_manager.py",
    "secondary_managers": ["username_manager.py"],
    "operations": [
      "settings_discovery",
      "user_config_management", 
      "settings_validation",
      "settings_persistence"
    ]
  },
  "cost_estimate": 0.003,
  "cache_settings": {
    "enabled": true,
    "duration_seconds": 720,
    "cache_key_includes": ["user_context", "settings_state", "directory_fingerprint"]
  },
  "integration": {
    "memory_mcp": false,
    "cache_system": true,
    "error_handling": true,
    "manager_touchpoints": ["settings_manager", "username_manager"]
  },
  "operations": {
    "execute": {
      "description": "Main config management operation",
      "required_params": [],
      "optional_params": ["operation", "setting_name", "value", "config_data"]
    }
  },
  "ui_patterns": {
    "display_type": "settings_management",
    "sections": ["current_settings", "available_options", "user_overrides", "defaults"],
    "interactions": ["setting_update", "reset_to_default", "bulk_import_export"]
  }
}