      "required_params": [],
      "optional_params": ["level"]
    },
    "status": {
      "description": "Show current verbose/debug status",
      "required_params": [],
      "optional_params": []
    },
    "info": {
      "description": "Show comprehensive debug information",
      "required_params": [],
      "optional_params": []
    }
  },
  "integration": {
    "memory_mcp": true,
    "cache_system": true,
    "error_handling": true,
    "manager_touchpoints": ["workflow_manager", "workflow_state", "memory_mcp"]
