{
  "command": "dry_run", 
  "type": "standalone",
  "terminal_flag": "--dry-run",
  "app_command": "/dry-run",
  "interface_method": "dry_run",
  "help": "Simulate workflow execution without actually running",
  "cost_estimate": 0.008,
  "logic_file": "configs/cli/dry_run/dry_run.py",
  "ui_file": "configs/cli/dry_run/ui_dry_run.py",
  "operations": {
    "execute": {
      "description": "Simulate workflow execution and validate configuration",
      "required_params": [],
      "optional_params": ["workflow", "detailed_validation", "execution_plan"]
    }
  },
  "integration": {
    "memory_mcp": true,
    "cache_system": true,
    "error_handling": true,
    "universal_touchpoints": ["cli_manager", "ui_terminal"],
    "specific_touchpoints": ["workflow_manager", "workflow_state", "memory_mcp"]
  },
  "cache_settings": {
    "enabled": true,
    "duration_seconds": 300,
    "cache_key_includes": ["workflow_directory_state", "system_state", "user_params"]
  }
}