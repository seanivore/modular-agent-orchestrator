{
  "name": "mao-terminal-playground",
  "version": "1.0.0",
  "type": "module",
  "description": "TypeScript/Node.js terminal UI playground exploring Claude Code capabilities",
  "main": "dist/playground.js",
  "scripts": {
    "start": "tsx src/playground.tsx",
    "build": "tsc",
    "dev": "tsx watch src/playground.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "ink-select-input": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "bin": {
    "mao-playground": "./dist/playground.js"
  },
  "keywords": [
    "terminal",
    "ui", 
    "typescript",
    "ink",
    "claude-code",
    "mao"
  ],
  "author": "Sean Horvath",
  "license": "MIT"
}
