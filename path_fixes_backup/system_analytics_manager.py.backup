    @handle_errors
    def calculate_time_patterns(self, user_analytics_data: List[Dict]) -> Dict:
        """Calculate anonymous time usage patterns"""
        try:
            peak_hours = {}
            peak_days = {}
            
            # Anonymize data before processing
            anonymized_data = [self._anonymize_user_data(user_data) for user_data in user_analytics_data]
            
            for user_data in anonymized_data:
                if "sessions" in user_data and "sessions" in user_data["sessions"]:
                    for session in user_data["sessions"]["sessions"]:
                        if session.get("start_time"):
                            start_time = datetime.fromisoformat(session["start_time"].replace('Z', '+00:00'))
                            
                            # Track hourly patterns
                            hour_range = f"{start_time.hour:02d}:00-{start_time.hour+1:02d}:00"
                            if hour_range not in peak_hours:
                                peak_hours[hour_range] = 0
                            peak_hours[hour_range] += 1
                            
                            # Track daily patterns
                            day_name = start_time.strftime("%A").lower()
                            if day_name not in peak_days:
                                peak_days[day_name] = 0
                            peak_days[day_name] += 1
            
            # Convert to percentages
            total_hours = sum(peak_hours.values())
            total_days = sum(peak_days.values())
            
            if total_hours > 0:
                peak_hours = {k: v / total_hours for k, v in peak_hours.items()}
            if total_days > 0:
                peak_days = {k: v / total_days for k, v in peak_days.items()}
            
            return {
                "peak_hours": peak_hours,
                "peak_days": peak_days
            }
            
        except Exception as e:
            return {"peak_hours": {}, "peak_days": {}}
    
    @handle_errors
    def update_aggregate_usage_with_time_patterns(self, user_analytics_data: List[Dict]) -> bool:
        """Update aggregate usage data with time patterns"""
        try:
            data = self._read_system_analytics_file("aggregate_usage.json")
            time_patterns = self.calculate_time_patterns(user_analytics_data)
            
            data["time_patterns"] = time_patterns
            data["metadata"]["last_updated"] = datetime.now(timezone.utc).isoformat()
            
            return self._write_system_analytics_file("aggregate_usage.json", data)
            
        except Exception as e:
            return False
    
    @handle_errors
    def get_system_analytics_summary(self) -> Dict:
        """Get comprehensive system analytics summary"""
        try:
            summary = {
                "aggregate_usage": self._read_system_analytics_file("aggregate_usage.json"),
                "tool_performance": self._read_system_analytics_file("tool_performance.json"),
                "privacy_compliance": {
                    "anonymization_applied": True,
                    "user_data_excluded": True,
                    "gdpr_compliant": True
                }
            }
            return summary
            
        except Exception as e:
            return {}
    
