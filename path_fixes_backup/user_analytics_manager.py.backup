"""
User Analytics Manager - Privacy-First Analytics Infrastructure
Tracks user-specific analytics with GDPR compliance and dynamic tool discovery
"""

import json
# import os  # Removed - was only used for sys.path.append
from pathlib import Path
from typing import Dict, List, Any, Optional
from datetime import datetime, timezone
from dataclasses import dataclass

# Standard MAO imports (following standardization pattern)
from orchestrator.cache.cache_system import CacheManager
from orchestrator.error_handling import handle_errors, retry_with_backoff, APIError
from orchestrator.username_manager import UsernameManager

# Standard cache instance
cache = CacheManager()

@dataclass
class SessionMetric:
    """Individual session tracking data"""
    session_id: str
    start_time: str
    end_time: Optional[str] = None
    duration_minutes: Optional[int] = None
    workflow_count: int = 0
    tool_activations: int = 0

@dataclass
class ToolUsageMetric:
    """Individual tool usage tracking data"""
    tool_name: str
    total_uses: int = 0
    success_rate: float = 0.0
    avg_response_time: float = 0.0
    last_used: Optional[str] = None

@dataclass
class WorkflowMetric:
    """Individual workflow tracking data"""
    workflow_id: str
    workflow_command: str
    start_time: str
    completion_time: Optional[str] = None
    success: bool = False
    workflow_tags: List[str] = None

@dataclass
class CostMetric:
    """Daily cost tracking data"""
    date: str
    total_spend: float = 0.0
    model_breakdown: Dict[str, float] = None
    session_count: int = 0

class UserAnalyticsManager:
    """
    Manages user-specific analytics with privacy-first architecture.
    
    Core Principles:
    1. All user data tied to user_id for GDPR compliance
    2. Dynamic tool discovery for analytics
    3. Error handling ensures analytics failures don't break main functionality
    4. Real-time metrics only - no mock data
    """
    
    def __init__(self, user_dir: str = "./configs/user/"):
        self.user_dir = Path(user_dir)
        self.username_manager = UsernameManager()
        
        # Ensure directories exist
        self.user_dir.mkdir(parents=True, exist_ok=True)
        
    @handle_errors
    def estimate_cost(self, operation: str = "analytics_operation") -> float:
        """Standard cost estimation for analytics operations"""
        cost_map = {
            "track_session": 0.001,
            "track_tool_usage": 0.0005,
            "track_workflow": 0.001,
            "track_costs": 0.0005,
            "analytics_operation": 0.001
        }
        return cost_map.get(operation, 0.001)
    
    @handle_errors
    def _get_user_analytics_dir(self, username: str) -> Path:
        """Get user analytics directory path"""
        return self.user_dir / username / "analytics"
    
    @handle_errors
    def _ensure_analytics_dir(self, username: str) -> Path:
        """Ensure user analytics directory exists"""
        analytics_dir = self._get_user_analytics_dir(username)
        analytics_dir.mkdir(parents=True, exist_ok=True)
        return analytics_dir
    
    @handle_errors
    def _read_analytics_file(self, username: str, filename: str) -> Dict:
        """Read analytics file with error handling"""
        analytics_dir = self._get_user_analytics_dir(username)
        file_path = analytics_dir / filename
        
        if not file_path.exists():
            return self._create_default_analytics_file(username, filename)
        
        try:
            with open(file_path, 'r') as f:
                return json.load(f)
        except (json.JSONDecodeError, IOError) as e:
            # Return default structure if file is corrupted
            return self._create_default_analytics_file(username, filename)
    
    @handle_errors
    def _write_analytics_file(self, username: str, filename: str, data: Dict) -> bool:
        """Write analytics file with error handling"""
        analytics_dir = self._ensure_analytics_dir(username)
        file_path = analytics_dir / filename
        
        try:
            with open(file_path, 'w') as f:
                json.dump(data, f, indent=2)
            return True
        except (IOError, json.JSONEncodeError) as e:
            # Analytics failures should not break main functionality
            return False
    
    @handle_errors
    def _create_default_analytics_file(self, username: str, filename: str) -> Dict:
        """Create default analytics file structure"""
        user_id = self.username_manager.get_user_id(username)
        current_time = datetime.now(timezone.utc).isoformat()
        
        defaults = {
            "session_metrics.json": {
                "sessions": [],
                "aggregates": {
                    "total_sessions": 0,
                    "average_duration": 0,
                    "total_time_minutes": 0
                },
                "metadata": {
                    "user_id": user_id,
                    "last_updated": current_time
                }
            },
            "tool_usage.json": {
                "tool_usage": {},
                "metadata": {
                    "user_id": user_id,
                    "total_tools_tracked": 0,
                    "discovery_enabled": True,
                    "last_discovery_scan": current_time,
                    "last_updated": current_time
                }
            },
            "workflow_metrics.json": {
                "workflows": [],
                "tag_analytics": {},
                "metadata": {
                    "user_id": user_id,
                    "total_workflows_tracked": 0,
                    "last_updated": current_time
                }
            },
            "cost_tracking.json": {
                "daily_costs": [],
                "totals": {
                    "monthly_spend": 0.0,
                    "avg_daily": 0.0
                },
                "metadata": {
                    "user_id": user_id,
                    "last_updated": current_time
                }
            }
        }
        
        default_data = defaults.get(filename, {})
        self._write_analytics_file(username, filename, default_data)
        return default_data
    
    @handle_errors
    def track_session(self, username: str, session_id: str, action: str, **kwargs) -> bool:
        """Track session metrics"""
        try:
            data = self._read_analytics_file(username, "session_metrics.json")
            current_time = datetime.now(timezone.utc).isoformat()
            
            if action == "start":
                session_metric = {
                    "session_id": session_id,
                    "start_time": current_time,
                    "end_time": None,
                    "duration_minutes": None,
                    "workflow_count": 0,
                    "tool_activations": 0
                }
                data["sessions"].append(session_metric)
                
            elif action == "end":
                # Find and update session
                for session in data["sessions"]:
                    if session["session_id"] == session_id:
                        session["end_time"] = current_time
                        start_time = datetime.fromisoformat(session["start_time"].replace('Z', '+00:00'))
                        end_time = datetime.fromisoformat(current_time.replace('Z', '+00:00'))
                        session["duration_minutes"] = int((end_time - start_time).total_seconds() / 60)
                        break
                
                # Update aggregates
                total_sessions = len(data["sessions"])
                completed_sessions = [s for s in data["sessions"] if s["end_time"] is not None]
                total_time = sum(s["duration_minutes"] for s in completed_sessions if s["duration_minutes"])
                
                data["aggregates"] = {
                    "total_sessions": total_sessions,
                    "average_duration": total_time / len(completed_sessions) if completed_sessions else 0,
                    "total_time_minutes": total_time
                }
                
            elif action == "update_workflow_count":
                for session in data["sessions"]:
                    if session["session_id"] == session_id:
                        session["workflow_count"] += 1
                        break
                        
            elif action == "update_tool_activations":
                for session in data["sessions"]:
                    if session["session_id"] == session_id:
                        session["tool_activations"] += 1
                        break
            
            data["metadata"]["last_updated"] = current_time
            return self._write_analytics_file(username, "session_metrics.json", data)
            
        except Exception as e:
            # Analytics failures should not break main functionality
            return False
    
    @handle_errors
    def track_tool_usage(self, username: str, tool_name: str, success: bool, response_time: float) -> bool:
        """Track tool usage metrics with dynamic discovery"""
        try:
            data = self._read_analytics_file(username, "tool_usage.json")
            current_time = datetime.now(timezone.utc).isoformat()
            
            # Auto-add tool if not tracked
            if tool_name not in data["tool_usage"]:
                data["tool_usage"][tool_name] = {
                    "total_uses": 0,
                    "success_rate": 0.0,
                    "avg_response_time": 0.0,
                    "last_used": None
                }
                data["metadata"]["total_tools_tracked"] = len(data["tool_usage"])
            
            tool_data = data["tool_usage"][tool_name]
            
            # Update metrics
            old_total = tool_data["total_uses"]
            tool_data["total_uses"] += 1
            tool_data["last_used"] = current_time
            
            # Update success rate
            if old_total == 0:
                tool_data["success_rate"] = 1.0 if success else 0.0
            else:
                current_successes = tool_data["success_rate"] * old_total
                new_successes = current_successes + (1 if success else 0)
                tool_data["success_rate"] = new_successes / tool_data["total_uses"]
            
            # Update average response time
            if old_total == 0:
                tool_data["avg_response_time"] = response_time
            else:
                current_avg = tool_data["avg_response_time"]
                tool_data["avg_response_time"] = (current_avg * old_total + response_time) / tool_data["total_uses"]
            
            data["metadata"]["last_updated"] = current_time
            return self._write_analytics_file(username, "tool_usage.json", data)
            
        except Exception as e:
            # Analytics failures should not break main functionality
            return False
    
    @handle_errors
    def track_workflow(self, username: str, workflow_id: str, workflow_command: str, action: str, **kwargs) -> bool:
        """Track workflow metrics"""
        try:
            data = self._read_analytics_file(username, "workflow_metrics.json")
            current_time = datetime.now(timezone.utc).isoformat()
            
            if action == "start":
                workflow_metric = {
                    "workflow_id": workflow_id,
                    "workflow_command": workflow_command,
                    "start_time": current_time,
                    "completion_time": None,
                    "success": False,
                    "workflow_tags": kwargs.get("tags", [])
                }
                data["workflows"].append(workflow_metric)
                
            elif action == "complete":
                # Find and update workflow
                for workflow in data["workflows"]:
                    if workflow["workflow_id"] == workflow_id:
                        workflow["completion_time"] = current_time
                        workflow["success"] = kwargs.get("success", False)
                        break
                
                # Update tag analytics
                for workflow in data["workflows"]:
                    if workflow["workflow_id"] == workflow_id and workflow["workflow_tags"]:
                        for tag in workflow["workflow_tags"]:
                            if tag not in data["tag_analytics"]:
                                data["tag_analytics"][tag] = {
                                    "usage_count": 0,
                                    "success_rate": 0.0,
                                    "avg_duration": 0.0
                                }
                            
                            tag_data = data["tag_analytics"][tag]
                            tag_data["usage_count"] += 1
                            
                            # Update success rate
                            if workflow["success"]:
                                current_successes = tag_data["success_rate"] * (tag_data["usage_count"] - 1)
                                tag_data["success_rate"] = (current_successes + 1) / tag_data["usage_count"]
                            
                            # Update average duration
                            if workflow["completion_time"] and workflow["start_time"]:
                                start_time = datetime.fromisoformat(workflow["start_time"].replace('Z', '+00:00'))
                                end_time = datetime.fromisoformat(workflow["completion_time"].replace('Z', '+00:00'))
                                duration = (end_time - start_time).total_seconds() / 60
                                
                                if tag_data["usage_count"] == 1:
                                    tag_data["avg_duration"] = duration
                                else:
                                    current_avg = tag_data["avg_duration"]
                                    tag_data["avg_duration"] = (current_avg * (tag_data["usage_count"] - 1) + duration) / tag_data["usage_count"]
                        break
            
            data["metadata"]["total_workflows_tracked"] = len(data["workflows"])
            data["metadata"]["last_updated"] = current_time
            return self._write_analytics_file(username, "workflow_metrics.json", data)
            
        except Exception as e:
            # Analytics failures should not break main functionality
            return False
    
    @handle_errors
    def track_costs(self, username: str, date: str, model_name: str, cost: float, session_id: str = None) -> bool:
        """Track cost metrics"""
        try:
            data = self._read_analytics_file(username, "cost_tracking.json")
            current_time = datetime.now(timezone.utc).isoformat()
            
            # Find or create daily cost entry
            daily_cost = None
            for cost_entry in data["daily_costs"]:
                if cost_entry["date"] == date:
                    daily_cost = cost_entry
                    break
            
            if daily_cost is None:
                daily_cost = {
                    "date": date,
                    "total_spend": 0.0,
                    "model_breakdown": {},
                    "session_count": 0
                }
                data["daily_costs"].append(daily_cost)
            
            # Update costs
            daily_cost["total_spend"] += cost
            
            if model_name not in daily_cost["model_breakdown"]:
                daily_cost["model_breakdown"][model_name] = 0.0
            daily_cost["model_breakdown"][model_name] += cost
            
            # Update session count if provided
            if session_id:
                daily_cost["session_count"] += 1
            
            # Update totals
            total_spend = sum(entry["total_spend"] for entry in data["daily_costs"])
            avg_daily = total_spend / len(data["daily_costs"]) if data["daily_costs"] else 0.0
            
            data["totals"] = {
                "monthly_spend": total_spend,
                "avg_daily": avg_daily
            }
            
            data["metadata"]["last_updated"] = current_time
            return self._write_analytics_file(username, "cost_tracking.json", data)
            
        except Exception as e:
            # Analytics failures should not break main functionality
            return False
    
    @handle_errors
    def scan_available_tools(self, username: str) -> List[str]:
        """Scan and discover available tools for analytics"""
        try:
            # This would integrate with manager_tools.py discover_all_tools()
            # For now, return basic implementation
            data = self._read_analytics_file(username, "tool_usage.json")
            tracked_tools = list(data["tool_usage"].keys())
            
            # Update discovery scan timestamp
            data["metadata"]["last_discovery_scan"] = datetime.now(timezone.utc).isoformat()
            self._write_analytics_file(username, "tool_usage.json", data)
            
            return tracked_tools
            
        except Exception as e:
            return []
    
    @handle_errors
    def auto_add_component(self, username: str, component_type: str, component_name: str) -> bool:
        """Automatically add new components to analytics tracking"""
        try:
            if component_type == "tool":
                data = self._read_analytics_file(username, "tool_usage.json")
                if component_name not in data["tool_usage"]:
                    data["tool_usage"][component_name] = {
                        "total_uses": 0,
                        "success_rate": 0.0,
                        "avg_response_time": 0.0,
                        "last_used": None
                    }
                    data["metadata"]["total_tools_tracked"] = len(data["tool_usage"])
                    data["metadata"]["last_updated"] = datetime.now(timezone.utc).isoformat()
                    return self._write_analytics_file(username, "tool_usage.json", data)
            
            return True
            
        except Exception as e:
            return False
    
    @handle_errors
    def get_user_analytics_summary(self, username: str) -> Dict:
        """Get comprehensive analytics summary for user"""
        try:
            summary = {
                "user_id": self.username_manager.get_user_id(username),
                "sessions": self._read_analytics_file(username, "session_metrics.json"),
                "tools": self._read_analytics_file(username, "tool_usage.json"),
                "workflows": self._read_analytics_file(username, "workflow_metrics.json"),
                "costs": self._read_analytics_file(username, "cost_tracking.json")
            }
            return summary
            
        except Exception as e:
            return {}
    
    @handle_errors
    def delete_user_analytics(self, username: str) -> bool:
        """Delete all user analytics data for GDPR compliance"""
        try:
            analytics_dir = self._get_user_analytics_dir(username)
            if analytics_dir.exists():
                for file_path in analytics_dir.glob("*.json"):
                    file_path.unlink()
                analytics_dir.rmdir()
                return True
            return True
            
        except Exception as e:
            return False