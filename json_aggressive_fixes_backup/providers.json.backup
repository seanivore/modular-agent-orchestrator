{
  "api_base": "default_api_base",
  "app_command": "/providers",
  "cache_settings": {
    "cache_key_includes": [
      "providers_directory_state",
      "provider_files_hash"
    ],
    "duration_seconds": 900,
    "enabled": true
  },
  "command": "providers",
  "cost_estimate": 0.001,
  "file_path": "configs/cli/providers/providers.py",
  "help": "List all available providers with metadata and capabilities",
  "integration": {
    "cache_system": true,
    "error_handling": true,
    "manager_touchpoints": [
      "manager_models"
    ],
    "memory_mcp": false
  },
  "interface_method": "list_providers",
  "name": "providers",
  "operations": {
    "list": {
      "description": "List all available providers with comprehensive metadata",
      "optional_params": [
        "format",
        "filter"
      ],
      "required_params": []
    }
  },
  "terminal_flag": "--providers",
  "type": "standalone",
  "ui_path": "configs/cli/providers/ui_providers.py"
}