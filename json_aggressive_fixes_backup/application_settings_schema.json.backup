{
  "application_settings": {
    "version": "1.0",
    "last_updated": "2025-06-25",
    "settings": {
      "quick_launch": {
        "default": "always",
        "description": "Launch app with last user logged in",
        "type": "select",
        "options": [
          {
            "value": "always",
            "label": "Always",
            "description": "Launch app with user from last session, unless logged out"
          },
          {
            "value": "off", 
            "label": "Off",
            "description": "Load Username login on every startup"
          },
          {
            "value": "continue_only",
            "label": "Continue Only", 
            "description": "Launch `mao --continue` to skip login, otherwise load Username login"
          }
        ]
      },
      "favorite_model": {
        "default": "claude-sonnet-4",
        "description": "Use for workflows unless discussed",
        "type": "model_select",
        "source": "dynamic_model_list",
        "fallback_options": [
          "claude-sonnet-4",
          "claude-opus-4", 
          "gemini-2.5-pro",
          "gpt-4.1-mini"
        ]
      },
      "default_provider": {
        "default": "anthropic direct",
        "description": "I prefer this provider; discuss to change",
        "type": "provider_select", 
        "source": "dynamic_provider_list",
        "fallback_options": [
          "anthropic direct",
          "openai direct",
          "gemini direct",
          "litellm"
        ]
      },
      "theme": {
        "default": "dark mode CVD",
        "description": "Dark computer theme; use high legibility colors",
        "type": "select",
        "options": [
          {
            "value": "dark_mode",
            "label": "Dark mode",
            "description": "Standard dark theme for most users"
          },
          {
            "value": "light_mode", 
            "label": "Light mode",
            "description": "Light theme for bright environments"
          },
          {
            "value": "dark_mode_cvd",
            "label": "Dark mode (CVD)",
            "description": "Dark mode with colorblind-friendly high contrast colors"
          },
          {
            "value": "light_mode_cvd",
            "label": "Light mode (CVD)", 
            "description": "Light mode with colorblind-friendly high contrast colors"
          },
          {
            "value": "dark_mode_ansi",
            "label": "Dark mode (ANSI colors only)",
            "description": "Dark mode using only basic terminal colors"
          },
          {
            "value": "light_mode_ansi",
            "label": "Light mode (ANSI colors only)",
            "description": "Light mode using only basic terminal colors"
          }
        ]
      },
      "cat_vibes": {
        "default": "I love it",
        "description": "We'll meow it up for you",
        "type": "select",
        "options": [
          {
            "value": "love_it",
            "label": "I love it",
            "description": "Full cat personality - meow messages, cat emoji, playful language"
          },
          {
            "value": "mao_and_then",
            "label": "Mao and then",
            "description": "Moderate cat vibes - some meow references but not overwhelming"
          },
          {
            "value": "be_serious_pls",
            "label": "Be serious pls", 
            "description": "Professional mode - no cat references, business language only"
          }
        ]
      },
      "double_texting": {
        "default": "always",
        "description": "Interrupt Mao like any messenger experience",
        "type": "select",
        "options": [
          {
            "value": "always",
            "label": "Always",
            "description": "Interrupt workflows and conversations anytime - feels like texting"
          },
          {
            "value": "never",
            "label": "Never",
            "description": "Wait for complete responses - one message at a time"
          }
        ]
      },
      "tone_notification": {
        "default": "once, no push",
        "description": "When a workflow is complete, a simple tone is played",
        "type": "select",
        "options": [
          {
            "value": "once_no_push",
            "label": "Once, no push",
            "description": "Simple system tone when workflow completes, no push notification"
          },
          {
            "value": "silent_push",
            "label": "Silent, push", 
            "description": "No sound, but send push notification with workflow results"
          },
          {
            "value": "no_notifications",
            "label": "No notifications",
            "description": "Complete silence - no sounds or notifications"
          }
        ]
      },
      "data_collection": {
        "default": "full_insights",
        "description": "What data we can collect to improve your experience",
        "type": "select",
        "options": [
          {
            "value": "full_insights",
            "label": "Full insights",
            "description": "Track all metrics for personal dashboard and community benchmarks"
          },
          {
            "value": "personal_only",
            "label": "Personal only", 
            "description": "Track personal metrics only - no anonymous community data"
          },
          {
            "value": "essential_only",
            "label": "Essential only",
            "description": "Basic usage tracking for app functionality - minimal data collection"
          },
          {
            "value": "no_tracking",
            "label": "No tracking",
            "description": "Disable all analytics and metrics - purely local usage"
          }
        ]
      }
    },
    "ui_metadata": {
      "config_interface": {
        "title": "Application Settings",
        "description": "Customize your MAO experience",
        "sections": [
          {
            "name": "Startup & Navigation",
            "settings": ["quick_launch", "favorite_model", "default_provider"]
          },
          {
            "name": "Interface & Experience", 
            "settings": ["theme", "cat_vibes", "double_texting"]
          },
          {
            "name": "Notifications & Privacy",
            "settings": ["tone_notification", "data_collection"]
          }
        ]
      },
      "visual_elements": {
        "selector_icon": "❯",
        "selected_icon": "✔",
        "help_icon": "?",
        "section_bullets": ["●", "└"],
        "preview_enabled": true
      }
    }
  }
}
