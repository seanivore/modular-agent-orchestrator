{
  "name": "output_directory",
  "type": "needs_input",
  "terminal_flag": "--output",
  "app_command": "/output",
  "interface_method": "output",
  "help": "Set output directory via settings_manager.py",
  "cost_estimate": 0.002,
  "logic_file": "configs/cli/output_directory/output_directory.py",
  "ui_file": "configs/cli/output_directory/ui_output_directory.py",
  "operations": {
    "set_output": {
      "description": "Set user output directory with path validation",
      "required_params": ["path"],
      "optional_params": []
    },
    "get_current_output": {
      "description": "Get current output directory setting",
      "required_params": [],
      "optional_params": []
    }
  },
  "integration": {
    "memory_mcp": false,
    "cache_system": true,
    "error_handling": true,
    "manager_touchpoints": ["settings_manager", "username_manager"]
  },
  "cache_settings": {
    "enabled": true,
    "duration_seconds": 300,
    "cache_key_includes": ["user_context", "current_output_state"]
  }
}