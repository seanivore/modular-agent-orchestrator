{
  "name": "user_template",
  "description": "Template for creating new user profiles",
  "version": "1.0.0",
  "username": "example_username",
  "user_id": "user-0000",
  "profile": {
    "display_name": "User Display Name",
    "preferences": {
      "theme": "default",
      "language": "en"
    }
  },
  "privacy": {
    "data_collection_consent": false,
    "analytics_consent": false,
    "contact_consent": false
  },
  "settings": {
    "default_provider": "anthropic-direct",
    "default_model": "claude-sonnet-4"
  },
  "_metadata": {
    "schema_version": "1.0",
    "template_type": "user_profile",
    "last_updated": "2025-01-21",
    "privacy_compliant": true,
    "note": "Personal data (name, email, DOB) should be handled via secure consent flow"
  }
}