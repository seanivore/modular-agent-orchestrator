{
  "command": "tools",
  "type": "standalone",
  "terminal_flag": "--tools",
  "app_command": "/tools",
  "interface_method": "list_tools",
  "help": "List all available tools",
  "cost_estimate": 0.001,
  "logic_file": "configs/cli/tools/tools.py",
  "ui_file": "configs/cli/tools/ui_tools.py",
  "operations": {
    "execute": {
      "description": "Display categorized list of all available tools with capabilities",
      "required_params": [],
      "optional_params": []
    }
  },
  "integration": {
    "memory_mcp": false,
    "cache_system": true,
    "error_handling": true,
    "universal_touchpoints": ["cli_manager", "ui_terminal"],
    "specific_touchpoints": ["manager_tools"]
  },
  "cache_settings": {
    "enabled": true,
    "duration_seconds": 600,
    "cache_key_includes": ["tools_directory_state", "tool_files_modification_times"]
  }
}